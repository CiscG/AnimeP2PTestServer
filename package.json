{
  "name": "anime-p2p",
  "version": "1.0.0",
  "description": "Compartilhamento de tela P2P com áudio isolado",
  "main": "main.js",
  "author": "CiscG",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  },
  "dependencies": {
    "electron-native-screenshare": "^1.0.0"
  },
  "build": {
    "appId": "com.ciscg.animep2p",
    "productName": "AnimeP2P",
    "win": {
      "target": ["nsis"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Network",
      "maintainer": "CiscG",
      "desktopName": "animep2p.desktop"
    },
    "publish": [
      {
        "provider": "github",
        "releaseType": "release"
      }
    ]
  }
}
